# Database Configuration
# Local Development (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drassistent

# Production (Neon) - Use the full connection string from Neon dashboard
# DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require

# Backend API Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO

# OpenRouter AI Configuration
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-placeholder-get-from-openrouter-ai
DIET_PLAN_MODEL=openai/gpt-4o-mini
DIET_PLAN_TEMPERATURE=0.7
FOOD_ENRICHMENT_MODEL=qwen/qwen-2.5-72b-instruct
FOOD_ENRICHMENT_TEMPERATURE=0.3

# CORS Configuration
# Local development: uses defaults (localhost:3000, localhost:5173, etc.)
# Production: Set comma-separated origins
# BACKEND_CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# pgAdmin (Optional - Local Development Only)
PGADMIN_EMAIL=admin@drassistent.com
PGADMIN_PASSWORD=admin
